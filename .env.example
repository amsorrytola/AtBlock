# Copy to .env — never commit real secrets

# Gateway
PORT=8787
PUBLIC_GATEWAY_URL=http://127.0.0.1:8787
FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
HEDERA_ASSET=0.0.0
PRICE_TINYBAR_PER_PROTOCOL=100000000
# UI wiring only — never for judges
DEMO_ACCEPT_PAYMENT=0
# Merchant / pay-to account (public id ok in docs; keep private key out of git)
HEDERA_PAYEE_ACCOUNT_ID=
HEDERA_PAYEE_PRIVATE_KEY=
# Buyer agent account used by demo client (`npm run pay -w @atblock/gateway`)
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PAYER_PRIVATE_KEY=

# The Graph (live provider — required for qualification)
GRAPH_API_KEY=
# Option A: full query URLs (comma-separated)
GRAPH_YIELD_ENDPOINTS=
# Option B: subgraph IDs expanded with GRAPH_API_KEY (Messari yield family preferred)
GRAPH_YIELD_SUBGRAPH_IDS=FDLuaz69DbMADuBjJDEcLnTuPnjhZqNbFVrkNiBLGkEg,G3JZhmKKHC4mydRzD6kSz5fCWve5WDYYCyTFSJyv3SD5
# yearn-v2 ethereum + arbitrum (Messari yield-aggregator schema)
# Optional 3rd for metering demo: ,BchjnXAXXV5coiCBMQH4A8yCHXEFX9S88JFF6G3mfem4 (badgerdao-ethereum)

HCS_TOPIC_ID=
# Optional distinct operator; defaults to payee if unset
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
ENS_RPC_URL=
ENS_PRIVATE_KEY=
ENS_AGENT_NAME=buyer.atblock.eth
ENS_EAC_CONTRACT=
